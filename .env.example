# Copy to .env for local development. Never commit .env.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://skinbywura_user:your_chosen_password@localhost:5432/skinbywura?sslmode=disable
SESSION_SECRET=change-me

# Browser origins allowed to call the API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Production: COOKIE_SECURE is forced on. Use COOKIE_SAMESITE=none only if the
# storefront and API are on different sites with no proxy in between.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Apply SQL migrations automatically at startup.
AUTO_MIGRATE=true

# Email (optional locally: without a key, emails are printed to the log).
RESEND_API_KEY=
MAIL_FROM=Skin By Wura <onboarding@resend.dev>
STORE_EMAIL=
STORE_NAME=Skin By Wura
PAYMENT_NOTE=
